rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function getUserData() {
      return get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isUserAdmin() {
      return getUserData().role == 'admin';
    }
    
    function isDepartment() {
      return getUserData().role == 'department';
    }

    // Students documents - only assigned employee or admin/dept can access
    match /students/{studentId}/{fileName} {
      allow read, write: if request.auth != null && (
        isUserAdmin() || isDepartment() ||
        get(/databases/(default)/documents/students/$(studentId)).data.employeeId == getUserData().civilId
      );
    }

    // Shared documents - admin/dept can write, all authenticated can read.
    match /shared_documents/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (isUserAdmin() || isDepartment());
    }

    // User avatars - owner can write, anyone can read.
    match /user_avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Public student uploads via shared link - anyone with a valid token can upload
    match /student_uploads/{token}/{fileName} {
      allow write: if firestore.exists(/databases/(default)/documents/upload_links/$(token));
      allow read, delete: if request.auth != null;
    }

  }
}
